+import { describe, expect, it } from "vitest";
+import { weatherCodeIcon } from "./weather";
+
+describe("weather code icons", () => {
+  it.each([
+    [0, "☀️"],
+    [2, "⛅"],
+    [45, "🌫️"],
+    [53, "🌦️"],
+    [63, "🌧️"],
+    [73, "❄️"],
+    [95, "⛈️"],
+    [999, "🌤️"],
+  ])("maps Open-Meteo code %s", (code, icon) => {
+    expect(weatherCodeIcon(code)).toBe(icon);
+  });
+});
