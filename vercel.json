{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": false
  },
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "installCommand": "corepack enable pnpm && pnpm install --frozen-lockfile",
  "framework": "vite",
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "images/activities/share-6x5/**"
    }
  },
  "rewrites": [
    {
      "source": "/e/:id",
      "destination": "/api/meta/event-preview-attributed?event=:id"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/meta/event-preview?slug=:slug"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
